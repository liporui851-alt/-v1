        ZIndex = 80, Parent = gui,
    })
    corner(panel, 12)
    stroke(panel, COLORS.border, 0.1, 1)

    label(panel, "API 配置", 16, COLORS.text, Enum.Font.SourceSansBold, {
        Position = UDim2.fromOffset(18, 16),
        Size = UDim2.new(1, -60, 0, 24), ZIndex = 81,
    })
    label(panel, "修改后点保存，立即生效", 10, COLORS.muted, Enum.Font.SourceSans, {
        Position = UDim2.fromOffset(18, 40),
        Size = UDim2.new(1, -60, 0, 16), ZIndex = 81,
    })

    local closeBtn = new("TextButton", {
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, -14, 0, 14),
        Size = UDim2.fromOffset(26, 26),
        BackgroundColor3 = COLORS.panelRaised,
        BorderSizePixel = 0, Text = "×",
        TextColor3 = COLORS.muted, TextSize = 16,
        Font = Enum.Font.SourceSansBold,
        AutoButtonColor = false, ZIndex = 81, Parent = panel,
    })
    corner(closeBtn, 6)
    closeBtn.MouseEnter:Connect(function()
        TweenService:Create(closeBtn, TweenInfo.new(0.12), {
            BackgroundColor3 = COLORS.danger, TextColor3 = Color3.fromRGB(255,255,255),
        }):Play()
    end)
    closeBtn.MouseLeave:Connect(function()
        TweenService:Create(closeBtn, TweenInfo.new(0.12), {
            BackgroundColor3 = COLORS.panelRaised, TextColor3 = COLORS.muted,
        }):Play()
    end)
    closeBtn.MouseButton1Click:Connect(function() panel.Visible = false end)

    -- 预设
    label(panel, "预设", 10, COLORS.muted, Enum.Font.SourceSansBold, {
        Position = UDim2.fromOffset(18, 70),
        Size = UDim2.fromOffset(100, 14), ZIndex = 81,
    })

    local presetButtons = {}
    local function refreshPresets(activeIdx)
        for i, btn in ipairs(presetButtons) do
            local isActive = (i == activeIdx)
            btn.BackgroundColor3 = isActive and COLORS.accent or COLORS.panelRaised
            btn.TextColor3 = isActive and Color3.fromRGB(255,255,255) or COLORS.text
        end
    end

    for i, preset in ipairs(PRESETS) do
        local b = new("TextButton", {
            Position = UDim2.fromOffset(18 + (i-1) * 88, 86),
            Size = UDim2.fromOffset(82, 28),
            BackgroundColor3 = COLORS.panelRaised,
            BorderSizePixel = 0, Text = preset.name,
            TextColor3 = COLORS.text, TextSize = 10,
            Font = Enum.Font.SourceSansSemibold,
            AutoButtonColor = false, ZIndex = 81, Parent = panel,
        })
        corner(b, 6)
        stroke(b, COLORS.border, 0.5, 1)
        b.MouseEnter:Connect(function()
            TweenService:Create(b, TweenInfo.new(0.12), {BackgroundColor3 = COLORS.accent}):Play()
        end)
        b.MouseLeave:Connect(function()
            if b.BackgroundColor3 ~= COLORS.accent then
                TweenService:Create(b, TweenInfo.new(0.12), {BackgroundColor3 = COLORS.panelRaised}):Play()
            end
        end)
        b.MouseButton1Click:Connect(function()
            refreshPresets(i)
            if preset.url ~= "" then
                urlBox.Text = preset.url
            end
            if #preset.models > 0 then
                modelBox.Text = preset.models[1]
            end
            toast("已切换: " .. preset.name, COLORS.accent, "◎")
        end)
        table.insert(presetButtons, b)
    end

    -- API 地址
    label(panel, "API 地址", 10, COLORS.muted, Enum.Font.SourceSansBold, {
        Position = UDim2.fromOffset(18, 128),
        Size = UDim2.fromOffset(200, 14), ZIndex = 81,
    })
    local urlBox = input(panel, "https://api.example.com/v1/chat/completions", "", {
        Position = UDim2.fromOffset(18, 146),
        Size = UDim2.new(1, -36, 0, 34),
        ZIndex = 81,
    })

    -- API Key
    label(panel, "API Key", 10, COLORS.muted, Enum.Font.SourceSansBold, {
        Position = UDim2.fromOffset(18, 190),
        Size = UDim2.fromOffset(200, 14), ZIndex = 81,
    })
    local keyBox = input(panel, "sk-...", "", {
        Position = UDim2.fromOffset(18, 208),
        Size = UDim2.new(1, -36, 0, 34),
        ZIndex = 81,
    })

    -- 模型
    label(panel, "模型名", 10, COLORS.muted, Enum.Font.SourceSansBold, {
        Position = UDim2.fromOffset(18, 252),
        Size = UDim2.fromOffset(200, 14), ZIndex = 81,
    })
    local modelBox = input(panel, "deepseek-flash", "", {
        Position = UDim2.fromOffset(18, 270),
        Size = UDim2.new(1, -36, 0, 34),
        ZIndex = 81,
    })

    -- 温度
    label(panel, "温度 (0.0 - 2.0)", 10, COLORS.muted, Enum.Font.SourceSansBold, {
        Position = UDim2.fromOffset(18, 314),
        Size = UDim2.fromOffset(200, 14), ZIndex = 81,
    })
    local tempBox = input(panel, "0.3", "0.3", {
        Position = UDim2.fromOffset(18, 332),
        Size = UDim2.new(1, -36, 0, 34),
        ZIndex = 81,
    })

    -- 按钮
    local applyBtn = new("TextButton", {
        Position = UDim2.fromOffset(18, 388),
        Size = UDim2.new(1, -36, 0, 40),
        BackgroundColor3 = COLORS.accent,
        BorderSizePixel = 0, Text = "保存并应用",
        TextColor3 = Color3.fromRGB(255, 255, 255),
        TextSize = 13, Font = Enum.Font.SourceSansBold,
        AutoButtonColor = false, ZIndex = 81, Parent = panel,
    })
    corner(applyBtn, 8)
    applyBtn.MouseEnter:Connect(function()
        TweenService:Create(applyBtn, TweenInfo.new(0.15), {
            BackgroundColor3 = COLORS.accentBright,
        }):Play()
    end)
    applyBtn.MouseLeave:Connect(function()
        TweenService:Create(applyBtn, TweenInfo.new(0.15), {
            BackgroundColor3 = COLORS.accent,
        }):Play()
    end)

    local testBtn = new("TextButton", {
        Position = UDim2.fromOffset(18, 436),
        Size = UDim2.new(1, -36, 0, 36),
        BackgroundColor3 = COLORS.panelRaised,
        BorderSizePixel = 0, Text = "测试连接",
        TextColor3 = COLORS.text, TextSize = 12,
        Font = Enum.Font.SourceSansSemibold,
        AutoButtonColor = false, ZIndex = 81, Parent = panel,
    })
    corner(testBtn, 8)
    stroke(testBtn, COLORS.border, 0.5, 1)
    testBtn.MouseEnter:Connect(function()
        TweenService:Create(testBtn, TweenInfo.new(0.12), {BackgroundColor3 = COLORS.panel}):Play()
    end)
    testBtn.MouseLeave:Connect(function()
        TweenService:Create(testBtn, TweenInfo.new(0.12), {BackgroundColor3 = COLORS.panelRaised}):Play()
    end)

    -- 状态文本
    local statusLabel = label(panel, "", 10, COLORS.muted, Enum.Font.SourceSans, {
        Position = UDim2.fromOffset(18, 478),
        Size = UDim2.new(1, -36, 0, 16), ZIndex = 81,
    })

    -- 测试连接
    testBtn.MouseButton1Click:Connect(function()
        local url = urlBox.Text
        local key = keyBox.Text
        local model = modelBox.Text

        if url == "" then
            statusLabel.Text = "请填写 API 地址"
            statusLabel.TextColor3 = COLORS.danger
            return
        end

        statusLabel.Text = "测试中..."
        statusLabel.TextColor3 = COLORS.orange

        task.spawn(function()
            local HttpService = game:GetService("HttpService")
            local body = HttpService:JSONEncode({
                model = model,
                messages = {{ role = "user", content = "hi" }},
                max_tokens = 5,
            })
            local headers = {
                ["Content-Type"] = "application/json",
                ["Authorization"] = "Bearer " .. key,
            }

            local ok, result
            if request then
                ok, result = pcall(function()
                    return request({Url = url, Method = "POST", Headers = headers, Body = body})
                end)
            else
                ok, result = pcall(function()
                    return HttpService:RequestAsync({Url = url, Method = "POST", Headers = headers, Body = body})
                end)
            end

            if ok and result then
                local code = result.StatusCode or 0
                if code == 200 then
                    statusLabel.Text = "✓ 连接成功"
                    statusLabel.TextColor3 = COLORS.green
                    toast("连接测试通过", COLORS.green, "✓")
                else
                    statusLabel.Text = "✗ 失败 HTTP " .. tostring(code)
                    statusLabel.TextColor3 = COLORS.danger
                    toast("连接失败: " .. tostring(code), COLORS.danger, "✕")
                end
            else
                statusLabel.Text = "✗ 请求失败"
                statusLabel.TextColor3 = COLORS.danger
                toast("请求失败", COLORS.danger, "✕")
            end
        end)
    end)

    -- 保存应用
    applyBtn.MouseButton1Click:Connect(function()
        local url = urlBox.Text
        local key = keyBox.Text
        local model = modelBox.Text
        local temp = tonumber(tempBox.Text) or 0.3

        if url == "" then
            toast("API 地址不能为空", COLORS.danger, "✕")
            return
        end

        -- 尝试改主 UI 的 key 输入框
        local mainKeyBox = findApiKeyBox()
        if mainKeyBox and key ~= "" then
            mainKeyBox.Text = key
            mainKeyBox:ReleaseFocus()
        end

        -- 存到全局，主脚本可读
        _G.CodexConfig = _G.CodexConfig or {}
        _G.CodexConfig.API_URL = url
        _G.CodexConfig.API_KEY = key
        _G.CodexConfig.MODEL = model
        _G.CodexConfig.TEMPERATURE = temp

        toast("已保存配置", COLORS.green, "✓")
        statusLabel.Text = "已保存 · " .. model
        statusLabel.TextColor3 = COLORS.green
    end)

    return panel, {
        urlBox = urlBox,
        keyBox = keyBox,
        modelBox = modelBox,
        tempBox = tempBox,
        statusLabel = statusLabel,
    }
end

