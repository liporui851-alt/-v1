local function findShell(root)
    for _, child in ipairs(root:GetChildren()) do
        if child:IsA("Frame") then
            return child
        end
    end
    local backdrop = root:FindFirstChild("Backdrop")
    if backdrop then
        for _, child in ipairs(backdrop:GetChildren()) do
            if child:IsA("Frame") then
                return child
            end
        end
    end
    return nil
end

local shell = findShell(gui)
if not shell then
    warn("[Ext] 找不到主窗口")
    return
end

-- 重跑本版本时移除旧控件并终止旧任务；旧版脚本的界面不受影响。
local RUNTIME_NAME = "CodexExtensionRuntimeV23"
local oldRuntime = gui:FindFirstChild(RUNTIME_NAME)
if oldRuntime then
    for _, ref in ipairs(oldRuntime:GetChildren()) do
        if ref:IsA("ObjectValue") and ref.Value then
            pcall(function() ref.Value:Destroy() end)
        end
    end
    oldRuntime:Destroy()
end

local runtime = Instance.new("Folder")
runtime.Name = RUNTIME_NAME
runtime.Parent = gui

local alive = true
local connections = {}
local activeTweens = setmetatable({}, { __mode = "k" })

local function connect(signal, callback)
    if #connections > 128 then
        for index = #connections, 1, -1 do
            if not connections[index].Connected then
                table.remove(connections, index)
            end
        end
    end
    local connection = signal:Connect(callback)
    table.insert(connections, connection)
    return connection
end

runtime.Destroying:Connect(function()
    alive = false
    for _, connection in ipairs(connections) do
        pcall(function() connection:Disconnect() end)
    end
    table.clear(connections)
end)

local function own(instance)
    local ref = Instance.new("ObjectValue")
    ref.Name = "OwnedUI"
    ref.Value = instance
    ref.Parent = runtime
    return instance
end

local COLORS = {
    accent       = Color3.fromRGB(122, 150, 255),
    accentBright = Color3.fromRGB(169, 188, 255),
    panel        = Color3.fromRGB(24, 28, 41),
    panelRaised  = Color3.fromRGB(33, 38, 55),
    border       = Color3.fromRGB(64, 72, 96),
    text         = Color3.fromRGB(241, 244, 252),
    muted        = Color3.fromRGB(151, 161, 184),
    green        = Color3.fromRGB(108, 211, 157),
    danger       = Color3.fromRGB(255, 113, 113),
    orange       = Color3.fromRGB(255, 180, 102),
    purple       = Color3.fromRGB(180, 130, 255),
}

local function new(className, properties)
    local instance = Instance.new(className)
    if properties then
        for property, value in pairs(properties) do
            instance[property] = value
        end
    end
    return instance
end

local function corner(parent, radius)
    return new("UICorner", { CornerRadius = UDim.new(0, radius), Parent = parent })
end

local function stroke(parent, color, transparency, thickness)
    return new("UIStroke", {
        Color = color,
        Transparency = transparency or 0,
        Thickness = thickness or 1,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        Parent = parent,
    })
end

local function label(parent, text, size, color, font, properties)
    local instance = new("TextLabel", {
        BackgroundTransparency = 1,
        Text = text,
        TextColor3 = color,
        TextSize = size,
        Font = font or Enum.Font.SourceSans,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,
        TextTransparency = 0,
        Parent = parent,
    })
    if properties then
        for property, value in pairs(properties) do
            instance[property] = value
        end
    end
    return instance
end

local function playTween(instance, info, properties)
    local oldTween = activeTweens[instance]
    if oldTween then
        pcall(function() oldTween:Cancel() end)
    end
    local tween = TweenService:Create(instance, info, properties)
    activeTweens[instance] = tween
    tween:Play()
    return tween
end

-- 状态提示：用序号作废旧的延时关闭任务，避免快速连续提示互相覆盖。
local function makeStatusToast()
    local holder = own(new("Frame", {
        Name = "ExtToastV23",
        Visible = false,
        AnchorPoint = Vector2.new(0.5, 0),
        Position = UDim2.new(0.5, 0, 0, -50),
        Size = UDim2.fromOffset(0, 40),
        AutomaticSize = Enum.AutomaticSize.X,
        BackgroundColor3 = COLORS.panel,
        BackgroundTransparency = 0.05,
        BorderSizePixel = 0,
        ZIndex = 200,
        Parent = gui,
    }))
    corner(holder, 10)
    stroke(holder, COLORS.border, 0.15, 1)
    new("UIPadding", {
        PaddingLeft = UDim.new(0, 14),
        PaddingRight = UDim.new(0, 18),
        Parent = holder,
    })
    local accentBar = new("Frame", {
        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0, 0, 0.5, 0),
        Size = UDim2.fromOffset(3, 22),
        BackgroundColor3 = COLORS.accent,
        BorderSizePixel = 0,
        ZIndex = 201,
        Parent = holder,
    })
    corner(accentBar, 2)
    local iconLabel = label(holder, "•", 16, COLORS.accent, Enum.Font.SourceSansBold, {
        Position = UDim2.fromOffset(12, 0),
        Size = UDim2.fromOffset(20, 40),
        ZIndex = 201,
    })
    local textLabel = label(holder, "", 12, COLORS.text, Enum.Font.SourceSansSemibold, {
        Position = UDim2.fromOffset(34, 0),
        Size = UDim2.new(0, 0, 1, 0),
        AutomaticSize = Enum.AutomaticSize.X,
        ZIndex = 201,
    })
    local generation = 0

    return function(message, color, icon)
        if not alive or not holder.Parent then return end
        generation += 1
        local current = generation
        color = color or COLORS.accent
        icon = icon or "•"
        holder.Visible = true
        holder.Position = UDim2.new(0.5, 0, 0, -50)
        holder.BackgroundTransparency = 0.05
        accentBar.BackgroundColor3 = color
        accentBar.BackgroundTransparency = 0
        iconLabel.Text = icon
        iconLabel.TextColor3 = color
        textLabel.Text = tostring(message)
        textLabel.TextColor3 = COLORS.text
        textLabel.TextTransparency = 0
        playTween(holder, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Position = UDim2.new(0.5, 0, 0, 20),
        })

        task.delay(2.6, function()
            if not alive or generation ~= current or not holder.Parent then return end
            local hideTween = playTween(holder, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
                Position = UDim2.new(0.5, 0, 0, -50),
                BackgroundTransparency = 1,
            })
            playTween(textLabel, TweenInfo.new(0.2), { TextTransparency = 1 })
            hideTween.Completed:Wait()
            if alive and generation == current and holder.Parent then
                holder.Visible = false
                holder.BackgroundTransparency = 0.05
                textLabel.TextTransparency = 0
            end
        end)
    end
end

