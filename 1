task.spawn(function()
    while alive and runtime.Parent == gui do
        local uptime = math.max(0, os.clock() - startTime)
        if statsLabels.messages.Parent then statsLabels.messages.Text = tostring(stats.messages) end
        if statsLabels.tools.Parent then statsLabels.tools.Text = tostring(stats.tools) end
        if statsLabels.uptime.Parent then statsLabels.uptime.Text = string.format("%.0fs", uptime) end

        local used, limit = findTokenUsage()
        if used then
            statsLabels.tokens.Text = tostring(used)
            statsLabels.limit.Text = limit and tostring(limit) or "无限制"
            if limit and limit > 0 and used >= limit then
                statsLabels.tokens.TextColor3 = COLORS.danger
            elseif limit and limit > 0 and used / limit >= 0.85 then
                statsLabels.tokens.TextColor3 = COLORS.orange
            else
                statsLabels.tokens.TextColor3 = COLORS.text
            end
            if not printedTokenStatus then
                printedTokenStatus = true
                print("[Ext] 已匹配 Token 用量")
            end
        else
            statsLabels.tokens.Text = "—"
            statsLabels.limit.Text = "—"
            if not printedTokenStatus then
                printedTokenStatus = true
                print("[Ext] 未发现可解析的 Token 标签")
            end
        end
        task.wait(0.5)
    end
end)

