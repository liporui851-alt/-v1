-- 统计消息和工具调用
local startTime = os.clock()
local stats = { messages = 0, tools = 0 }

local function isToolMessage(message)
    local header = message:FindFirstChild("Header", true)
    if not header then return false end
    local text = ""
    if header:IsA("TextLabel") or header:IsA("TextButton") then
        text = header.Text
    end
    local lower = text:lower()
    return text:find("工具", 1, true) ~= nil or lower:find("tool", 1, true) ~= nil
end

local conversation = findConversation()
if conversation then
    for _, child in ipairs(conversation:GetChildren()) do
        if child:IsA("Frame") then
            stats.messages += 1
            if isToolMessage(child) then stats.tools += 1 end
        end
    end
    connect(conversation.ChildAdded, function(child)
        if not child:IsA("Frame") then return end
        stats.messages += 1
        if isToolMessage(child) then stats.tools += 1 end
    end)
end

-- Token 文本匹配与数字格式解析，支持 1,200 / 8,000、1.2k/8k 和“x of y”。
local function parseQuantity(value)
    if not value then return nil end
    local numberText, suffix = value:match("([%d][%d,%.]*)%s*([kKmMbB]?)")
    if not numberText then return nil end
    suffix = suffix or ""
    numberText = numberText:gsub(",", "")
    local number = tonumber(numberText)
    if not number then return nil end
    local multiplier = ({ k = 1000, m = 1000000, b = 1000000000 })[suffix:lower()] or 1
    return math.floor(number * multiplier + 0.5)
end

local function parseToken(text)
    if type(text) ~= "string" or text == "" then return nil, nil end
    local lower = text:lower()
    local left, right = text:match("([%d][%d,%.]*%s*[kKmMbB]?)%s*/%s*([%d][%d,%.]*%s*[kKmMbB]?)")
    if not left then
        left, right = text:match("([%d][%d,%.]*%s*[kKmMbB]?)%s+[Oo][Ff]%s+([%d][%d,%.]*%s*[kKmMbB]?)")
    end
    if left and right then
        return parseQuantity(left), parseQuantity(right)
    end

    -- 单值只有在内容确实带有 Token/上下文提示时才作为已用量读取。
    if lower:find("token", 1, true) or lower:find("上下文", 1, true) or lower:find("令牌", 1, true) then
        local quantity = text:match("([%d][%d,%.]*%s*[kKmMbB]?)")
        if quantity then return parseQuantity(quantity), nil end
    end
    return nil, nil
end

local function isTokenText(text, name)
    local haystack = (tostring(text or "") .. " " .. tostring(name or "")):lower()
    return haystack:find("token", 1, true)
        or haystack:find("上下文", 1, true)
        or haystack:find("令牌", 1, true)
end

local function hasTokenContext(instance)
    if isTokenText(instance.Text, instance.Name) then return true end
    local parent = instance.Parent
    for _ = 1, 3 do
        if not parent then break end
        if isTokenText(parent.Name, parent.Name) then return true end
        for _, sibling in ipairs(parent:GetChildren()) do
            if sibling ~= instance and (sibling:IsA("TextLabel") or sibling:IsA("TextButton"))
                and isTokenText(sibling.Text, sibling.Name) then
                return true
            end
        end
        parent = parent.Parent
    end
    return false
end

local tokenCandidates = setmetatable({}, { __mode = "k" })
local function watchTokenLabel(instance)
    if not instance:IsA("TextLabel") or tokenCandidates[instance] then return end
    if not hasTokenContext(instance) then return end
    -- 一旦识别为 Token 标签就保留候选资格；主 UI 常会在后续更新中省略“Token”字样。
    tokenCandidates[instance] = true
end

for _, descendant in ipairs(shell:GetDescendants()) do
    watchTokenLabel(descendant)
end
connect(shell.DescendantAdded, watchTokenLabel)

local printedTokenStatus = false
local function findTokenUsage()
    local bestUsed, bestLimit, bestScore
    for candidate in pairs(tokenCandidates) do
        if candidate.Parent then
            local text = candidate.Text or ""
            local used, limit = parseToken(text)
            if used then
                local lower = text:lower()
                local score = 0
                if lower:find("token", 1, true) then score += 10 end
                if lower:find("上下文", 1, true) or lower:find("令牌", 1, true) then score += 8 end
                if candidate.Name:lower():find("token", 1, true) then score += 8 end
                local context = candidate.Parent
                for _ = 1, 3 do
                    if not context then break end
                    if context.Name:lower():find("token", 1, true)
                        or context.Name:lower():find("context", 1, true) then
                        score += 5
                    end
                    context = context.Parent
                end
                if limit then score += 4 end
                if candidate.Visible then score += 1 end
                if not bestScore or score > bestScore then
                    bestUsed, bestLimit, bestScore = used, limit, score
                end
            end
        else
            tokenCandidates[candidate] = nil
        end
    end
    return bestUsed, bestLimit
end

-- 快捷键
connect(UserInputService.InputBegan, function(input, processed)
    if processed or not alive then return end
    local controlDown = UserInputService:IsKeyDown(Enum.KeyCode.LeftControl)
        or UserInputService:IsKeyDown(Enum.KeyCode.RightControl)
    if not controlDown then return end
    if input.KeyCode == Enum.KeyCode.H then
        refreshHistory()
        togglePanel(historyPanel, statsPanel)
    elseif input.KeyCode == Enum.KeyCode.L then
        if clearConversation() then toast("已清空对话", COLORS.green, "✓") end
    end
end)

-- 监听当前及后续创建的输入框，避免主脚本延迟创建时历史无法记录。
local connectedTextBoxes = setmetatable({}, { __mode = "k" })
local function watchInputBox(instance)
    if not instance:IsA("TextBox") or connectedTextBoxes[instance] then return end
    local preferred = (instance.PlaceholderText or ""):lower():find("codex", 1, true)
    local name = instance.Name:lower()
    if not preferred and not name:find("input", 1, true)
        and not name:find("prompt", 1, true) and not name:find("command", 1, true) then
        return
    end
    connectedTextBoxes[instance] = true
    connect(instance.FocusLost, function(enterPressed)
        if enterPressed and instance.Text ~= "" then
            pushCommand(instance.Text)
            refreshHistory()
        end
    end)
end

