local function findAllTextBoxes()
    local list = {}
    for _, d in ipairs(shell:GetDescendants()) do
        if d:IsA("TextBox") then
            table.insert(list, d)
        end
    end
    return list
end

-- 找 API Key 输入框（placeholder 是 sk-... 的）
local function findApiKeyBox()
    for _, box in ipairs(findAllTextBoxes()) do
        if box.PlaceholderText and (box.PlaceholderText:find("sk") or box.PlaceholderText:find("API")) then
            return box
        end
    end
    return nil
end

