-- ============================================================
-- 统计刷新
-- ============================================================
local startTime = tick()
local stats = { messages = 0, tools = 0 }

local conversation = shell:FindFirstChild("Conversation", true)
if conversation then
    conversation.ChildAdded:Connect(function(child)
        stats.messages += 1
        if child:IsA("Frame") then
            local head = child:FindFirstChild("Header", true)
            if head and head.Text and head.Text:find("工具") then
                stats.tools += 1
            end
        end
    end)
end

local function findTokenLabel()
    local candidates = {}
    for _, d in ipairs(shell:GetDescendants()) do
        if d:IsA("TextLabel") and d.Text ~= "" then
            local lower = d.Text:lower()
            if lower:find("token") or lower:find("tokens") then
                table.insert(candidates, d)
            end
        end
    end
    if #candidates > 0 then return candidates[1] end
    return nil
end

local function parseToken(text)
    if not text then return nil, nil end
    local nums = {}
    for n in text:gmatch("%d+") do
        table.insert(nums, tonumber(n))
    end
    if text:find("/") and #nums >= 2 then
        return nums[1], nums[2]
    end
    if #nums >= 1 then
        return nums[1], nil
    end
    return nil, nil
end

task.spawn(function()
    while gui.Parent do
        local uptime = tick() - startTime
        statsLabels.messages.Text = tostring(stats.messages)
        statsLabels.tools.Text = tostring(stats.tools)
        statsLabels.uptime.Text = string.format("%.0fs", uptime)

        local tokenLbl = findTokenLabel()
        if tokenLbl then
            local used, limit = parseToken(tokenLbl.Text)
            if used then
                statsLabels.tokens.Text = tostring(used)
                if limit then
                    statsLabels.limit.Text = tostring(limit)
                    if limit > 0 and used >= limit then
                        statsLabels.tokens.TextColor3 = COLORS.danger
                    elseif limit > 0 and used / limit > 0.85 then
                        statsLabels.tokens.TextColor3 = COLORS.orange
                    else
                        statsLabels.tokens.TextColor3 = COLORS.text
                    end
                else
                    statsLabels.limit.Text = "无限制"
                    statsLabels.tokens.TextColor3 = COLORS.text
                end
            else
                statsLabels.tokens.Text = "—"
                statsLabels.limit.Text = "—"
            end
        else
            statsLabels.tokens.Text = "—"
            statsLabels.limit.Text = "—"
        end

        task.wait(0.5)
    end
end)

