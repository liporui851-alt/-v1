local toastBar = new("Frame", {
    AnchorPoint = Vector2.new(0, 0.5),
    Position = UDim2.new(0, 0, 0.5, 0),
    Size = UDim2.fromOffset(3, 22),
    BackgroundColor3 = COLORS.accent,
    BorderSizePixel = 0, ZIndex = 251, Parent = toastHolder,
})
corner(toastBar, 2)
local toastIcon = label(toastHolder, "•", 16, COLORS.accent, Enum.Font.SourceSansBold, {
    Position = UDim2.fromOffset(12, 0), Size = UDim2.fromOffset(20, 38), ZIndex = 251,
})
local toastText = label(toastHolder, "", 12, COLORS.text, Enum.Font.SourceSansSemibold, {
    Position = UDim2.fromOffset(34, 0),
    Size = UDim2.new(0, 0, 1, 0),
    AutomaticSize = Enum.AutomaticSize.X, ZIndex = 251,
})

local toastConn
local function toast(msg, color, icon)
    color = color or COLORS.accent
    icon = icon or "•"
    if toastConn then toastConn:Disconnect() end
    toastHolder.Visible = true
    toastHolder.Position = UDim2.new(0.5, 0, 0, -50)
    toastHolder.BackgroundTransparency = 0.05
    toastBar.BackgroundColor3 = color
    toastIcon.Text = icon
    toastIcon.TextColor3 = color
    toastText.Text = msg
    toastText.TextColor3 = COLORS.text
    toastText.TextTransparency = 0
    toastBar.BackgroundTransparency = 0
    TweenService:Create(toastHolder, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Position = UDim2.new(0.5, 0, 0, 20),
    }):Play()
    toastConn = task.delay(2.6, function()
        local t = TweenService:Create(toastHolder, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
            Position = UDim2.new(0.5, 0, 0, -50), BackgroundTransparency = 1,
        })
        local t2 = TweenService:Create(toastText, TweenInfo.new(0.2), {TextTransparency = 1})
        t:Play(); t2:Play()
        t.Completed:Wait()
        toastHolder.Visible = false
        toastHolder.BackgroundTransparency = 0.05
        toastText.TextTransparency = 0
    end)
end

