local function togglePanel(panel, other)
    if other then other.Visible = false end
    if panel.Visible then
        local tween = playTween(panel, TweenInfo.new(0.15), { BackgroundTransparency = 1 })
        task.spawn(function()
            tween.Completed:Wait()
            if alive and panel.Parent and panel.BackgroundTransparency >= 0.99 then
                panel.Visible = false
                panel.BackgroundTransparency = 0.02
            end
        end)
    else
        panel.Visible = true
        panel.BackgroundTransparency = 1
        playTween(panel, TweenInfo.new(0.2, Enum.EasingStyle.Quad), { BackgroundTransparency = 0.02 })
    end
end

local function findConversation()
    return shell:FindFirstChild("Conversation", true)
end

local function clearConversation()
    local conversation = findConversation()
    if not conversation then
        toast("找不到对话区", COLORS.danger, "✕")
        return false
    end
    for _, child in ipairs(conversation:GetChildren()) do
        if child:IsA("GuiObject") then
            child:Destroy()
        end
    end
    return true
end

local function copyConversation()
    local conversation = findConversation()
    if not conversation then
        toast("找不到对话区", COLORS.danger, "✕")
        return
    end

    local rows = {}
    for order, child in ipairs(conversation:GetChildren()) do
        if child:IsA("Frame") then
            table.insert(rows, { instance = child, order = child.LayoutOrder, fallbackOrder = order })
        end
    end
    table.sort(rows, function(a, b)
        if a.order == b.order then return a.fallbackOrder < b.fallbackOrder end
        return a.order < b.order
    end)

    local messages = {}
    for _, rowInfo in ipairs(rows) do
        local labels = {}
        for _, descendant in ipairs(rowInfo.instance:GetDescendants()) do
            if descendant:IsA("TextLabel") and descendant.Visible then
                local text = descendant.Text:gsub("^%s*(.-)%s*$", "%1")
                if text ~= "" then
                    table.insert(labels, { text = text, y = descendant.AbsolutePosition.Y, x = descendant.AbsolutePosition.X })
                end
            end
        end
        table.sort(labels, function(a, b)
            if a.y == b.y then return a.x < b.x end
            return a.y < b.y
        end)
        local parts = {}
        for _, item in ipairs(labels) do
            if parts[#parts] ~= item.text then
                table.insert(parts, item.text)
            end
        end
        if #parts > 0 then table.insert(messages, table.concat(parts, "\n")) end
    end

    local clipboard = setclipboard
    if type(clipboard) ~= "function" then
        toast("当前环境不支持剪贴板", COLORS.danger, "✕")
        return
    end
    local success = pcall(clipboard, table.concat(messages, "\n---\n"))
    if success then
        toast("已复制 " .. tostring(#messages) .. " 条消息", COLORS.green, "✓")
    else
        toast("复制失败", COLORS.danger, "✕")
    end
end

