local function buildQuickBar()
    local bar = own(new("Frame", {
        Name = "ExtQuickBarV23",
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -12, 0.5, 0),
        Size = UDim2.fromOffset(46, 340),
        BackgroundColor3 = COLORS.panel,
        BackgroundTransparency = 0.08,
        BorderSizePixel = 0,
        Active = true,
        ZIndex = 30,
        Parent = shell,
    }))
    corner(bar, 23)
    stroke(bar, COLORS.border, 0.35, 1)
    new("UIListLayout", {
        Padding = UDim.new(0, 6),
        HorizontalAlignment = Enum.HorizontalAlignment.Center,
        VerticalAlignment = Enum.VerticalAlignment.Center,
        SortOrder = Enum.SortOrder.LayoutOrder,
        Parent = bar,
    })

    local function makeToolButton(icon, tip, callback, order)
        local button = new("TextButton", {
            Size = UDim2.fromOffset(36, 36),
            BackgroundColor3 = COLORS.panelRaised,
            BackgroundTransparency = 0.25,
            BorderSizePixel = 0,
            Text = icon,
            TextColor3 = COLORS.text,
            TextSize = 17,
            Font = Enum.Font.SourceSansBold,
            AutoButtonColor = false,
            LayoutOrder = order,
            ZIndex = 31,
            Parent = bar,
        })
        corner(button, 18)
        local buttonStroke = stroke(button, COLORS.border, 0.5, 1)
        local hovering = false

        local function updateVisual(size)
            playTween(button, TweenInfo.new(0.14, Enum.EasingStyle.Quad), {
                BackgroundTransparency = hovering and 0 or 0.25,
                BackgroundColor3 = hovering and COLORS.accent or COLORS.panelRaised,
                TextColor3 = hovering and Color3.new(1, 1, 1) or COLORS.text,
                Size = UDim2.fromOffset(size, size),
            })
            playTween(buttonStroke, TweenInfo.new(0.14), {
                Color = hovering and COLORS.accentBright or COLORS.border,
                Transparency = hovering and 0.2 or 0.5,
            })
        end

        connect(button.MouseEnter, function()
            hovering = true
            updateVisual(40)
        end)
        connect(button.MouseLeave, function()
            hovering = false
            updateVisual(36)
        end)
        connect(button.MouseButton1Down, function()
            updateVisual(32)
        end)
        connect(button.MouseButton1Up, function()
            updateVisual(hovering and 40 or 36)
        end)
        connect(button.MouseButton1Click, callback)
        attachTooltip(button, tip)
        return button
    end

    local dragging = false
    local dragInput
    local dragStart
    local startPosition
    connect(bar.InputBegan, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPosition = bar.Position
            dragInput = input.UserInputType == Enum.UserInputType.Touch and input or nil
        end
    end)
    connect(UserInputService.InputChanged, function(input)
        if not dragging then return end
        if input.UserInputType ~= Enum.UserInputType.MouseMovement and input ~= dragInput then return end
        local delta = input.Position - dragStart
        bar.Position = UDim2.new(
            startPosition.X.Scale,
            startPosition.X.Offset + delta.X,
            startPosition.Y.Scale,
            startPosition.Y.Offset + delta.Y
        )
    end)
    connect(UserInputService.InputEnded, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input == dragInput then
            dragging = false
            dragInput = nil
        end
    end)
    return bar, makeToolButton
end

-- 命令历史
local commandHistory = {}
local MAX_HISTORY = 50

local function pushCommand(text)
    text = tostring(text or ""):match("^%s*(.-)%s*$")
    if text == "" then return end
    table.insert(commandHistory, 1, { text = text, time = os.time() })
    if #commandHistory > MAX_HISTORY then
        table.remove(commandHistory, #commandHistory)
    end
end

local function formatTime(timestamp)
    return os.date("%H:%M:%S", timestamp)
end

local function findInputBox()
    local fallback
    for _, descendant in ipairs(shell:GetDescendants()) do
        if descendant:IsA("TextBox") then
            local placeholder = (descendant.PlaceholderText or ""):lower()
            local name = descendant.Name:lower()
            if placeholder:find("codex", 1, true) then
                return descendant
            end
            if name:find("input", 1, true) or name:find("prompt", 1, true) or name:find("command", 1, true) then
                fallback = fallback or descendant
            end
        end
    end
    return fallback
end

