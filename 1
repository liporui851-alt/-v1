                Size = UDim2.fromOffset(50, 14),
                TextXAlignment = Enum.TextXAlignment.Right, ZIndex = 38,
            })
            label(row, "点击填入", 9, COLORS.accent, Enum.Font.SourceSans, {
                Position = UDim2.fromOffset(10, 24), Size = UDim2.fromOffset(80, 12), ZIndex = 38,
            })
            row.MouseEnter:Connect(function()
                TweenService:Create(row, TweenInfo.new(0.12), {
