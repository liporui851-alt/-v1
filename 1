local function attachTooltip(button, text)
    connect(button.MouseEnter, function()
        if not button.Parent then return end
        tooltipLabel.Text = text
        tooltipHolder.Visible = true
        local position = button.AbsolutePosition
        local size = button.AbsoluteSize
        task.defer(function()
            if not alive or not tooltipHolder.Parent or not button.Parent then return end
            local viewport = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1920, 1080)
            local width = tooltipHolder.AbsoluteSize.X
            local x = math.max(4, math.min(position.X - width - 10, viewport.X - width - 4))
            local y = math.max(4, math.min(position.Y + size.Y / 2 - 13, viewport.Y - 30))
            tooltipHolder.Position = UDim2.fromOffset(x, y)
        end)
    end)
    connect(button.MouseLeave, function()
        tooltipHolder.Visible = false
    end)
    connect(button.MouseButton1Down, function()
        tooltipHolder.Visible = false
    end)
end

